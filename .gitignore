*.iml
.gradle
.kotlin
/local.properties
# Config del IDE fuera del control de versiones (se retiró completa del repo al pasar el
# proyecto a uso personal; Android Studio la regenera localmente).
/.idea/
# Ajustes LOCALES de Claude Code (por máquina). Nunca se versionan: contienen permisos del
# equipo y variables de entorno con secretos (p. ej. NOTION_TOKEN de la sync con Notion).
/.claude/settings.local.json
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
# BLD2-05: backups de local.properties (p. ej. .winbak del flujo de build WSL) pueden contener
# rutas locales o credenciales y NO deben subirse.
local.properties.*
*.winbak
.env
debug.keystore
*.jks
*.keystore
# BLD2-04: un keystore codificado en base64 esquivaba las reglas anteriores.
*.keystore.base64
