<?xml version="1.0" encoding="utf-8"?>
<!--
   Configuración de seguridad de red. La app es offline-first; las ÚNICAS conexiones salientes
   posibles son OPCIONALES y las activa el usuario: la API de precios de mercado (finnhub.io,
   con MARKET_API_KEY) y la sync one-way con Notion (api.notion.com, con token de integración).
   Se prohíbe TODO tráfico en claro (HTTP): cualquier conexión debe ser HTTPS (base-config),
   evitando interceptación/filtración de datos. Sin key/token configurados, no hay tráfico.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">finnhub.io</domain>
    </domain-config>
</network-security-config>
