<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de extracción (Android 12+). Aunque android:allowBackup="false" desactiva el
   respaldo por completo, se excluyen explícitamente los datos sensibles como defensa en
   profundidad: base de datos financiera (Room/SQLCipher) y preferencias de seguridad.
   BLD2-02: se excluye el dominio "database" COMPLETO (path=".") — la exclusión por nombre
   exacto no cubría los sidecars -wal/-shm/-journal, que contienen las transacciones más
   recientes y se transferirían en herramientas D2D que honran estas reglas.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/security_prefs.preferences_pb" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/security_prefs.preferences_pb" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
